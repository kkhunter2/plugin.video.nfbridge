# Python
__pycache__/
*.pyc

# Build output of the runtime exe (rebuilt by runtime/webview/build_exe.py)
runtime/webview/build/
runtime/webview/dist/
*.spec
*.log

# Per-user material — never commit. (Since 0.3.0 the WebView2 profile and the font
# cache live in Kodi's addon_data dir; these cover older layouts / stray runs.)
runtime/webview/profile/
runtime/webview/cache/

# Claude Code / oh-my-claudecode session state
.omc/
