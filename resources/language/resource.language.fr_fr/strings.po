# ---- Browse ----
msgctxt "#30001"
msgid "Search"
msgstr "Rechercher"

msgctxt "#30002"
msgid "My List"
msgstr "Ma liste"

msgctxt "#30003"
msgid "Series & Movies"
msgstr "Séries et films"

msgctxt "#30004"
msgid "Profiles"
msgstr "Profils"

msgctxt "#30005"
msgid "Sign out"
msgstr "Se déconnecter"

msgctxt "#30006"
msgid "Sign in to Netflix"
msgstr "Se connecter à Netflix"

msgctxt "#30007"
msgid "Series"
msgstr "Séries"

msgctxt "#30008"
msgid "Movies"
msgstr "Films"

msgctxt "#30009"
msgid "Starting Netflix..."
msgstr "Démarrage de Netflix..."

msgctxt "#30010"
msgid "Stop the current playback to browse Netflix"
msgstr "Arrêtez la lecture en cours pour parcourir Netflix"

msgctxt "#30011"
msgid "Profile switched"
msgstr "Profil changé"

msgctxt "#30012"
msgid "Netflix is busy - try again"
msgstr "Netflix est occupé, réessayez"

# ---- Player OSD ----
msgctxt "#30020"
msgid "Play"
msgstr "Lecture"

msgctxt "#30021"
msgid "Pause"
msgstr "Pause"

msgctxt "#30022"
msgid "Subtitles"
msgstr "Sous-titres"

msgctxt "#30023"
msgid "Next episode"
msgstr "Épisode suivant"

msgctxt "#30024"
msgid "Back"
msgstr "Retour"

# ---- Messages ----
msgctxt "#30030"
msgid "No Netflix app, Edge or Chrome found for playback"
msgstr "Aucune application Netflix, ni Edge, ni Chrome trouvé pour la lecture"

msgctxt "#30031"
msgid "Netflix is not ready"
msgstr "Netflix n'est pas prêt"

msgctxt "#30032"
msgid "Profile switch failed"
msgstr "Échec du changement de profil"

msgctxt "#30033"
msgid "Pick a profile in the Netflix window, then open the add-on again"
msgstr "Choisissez un profil dans la fenêtre Netflix, puis rouvrez l'extension"

msgctxt "#30034"
msgid "Netflix runtime not found - reinstall the add-on"
msgstr "Moteur Netflix introuvable, réinstallez l'extension"

msgctxt "#30035"
msgid "Sign in to Netflix in the window, then return to Kodi"
msgstr "Connectez-vous à Netflix dans la fenêtre, puis revenez à Kodi"

msgctxt "#30036"
msgid "Could not open the sign-in window"
msgstr "Impossible d'ouvrir la fenêtre de connexion"

msgctxt "#30037"
msgid "Subtitle font \"{0}\" is unusable - using the Netflix font"
msgstr "La police de sous-titres « {0} » est inutilisable, la police Netflix est utilisée"

msgctxt "#30038"
msgid "Could not process the subtitle font - using the Netflix font"
msgstr "Impossible de traiter la police de sous-titres, la police Netflix est utilisée"

msgctxt "#30039"
msgid "No video selected"
msgstr "Aucune vidéo sélectionnée"

msgctxt "#30040"
msgid "Not signed in to Netflix - use \"Sign in to Netflix\" first"
msgstr "Non connecté à Netflix, utilisez d'abord « Se connecter à Netflix »"

msgctxt "#30041"
msgid "Could not load home: {0}"
msgstr "Impossible de charger l'accueil : {0}"

msgctxt "#30042"
msgid "This row is no longer on Netflix"
msgstr "Cette rangée n'existe plus sur Netflix"

msgctxt "#30043"
msgid "Could not load row: {0}"
msgstr "Impossible de charger la rangée : {0}"

msgctxt "#30044"
msgid "No profiles found"
msgstr "Aucun profil trouvé"

msgctxt "#30045"
msgid "Could not load category: {0}"
msgstr "Impossible de charger la catégorie : {0}"

msgctxt "#30046"
msgid "To sign out, use the account menu in the Netflix window"
msgstr "Pour vous déconnecter, utilisez le menu du compte dans la fenêtre Netflix"

msgctxt "#30047"
msgid "Could not load My List: {0}"
msgstr "Impossible de charger Ma liste : {0}"

msgctxt "#30048"
msgid "Search failed: {0}"
msgstr "Échec de la recherche : {0}"

msgctxt "#30049"
msgid "Could not load episodes: {0}"
msgstr "Impossible de charger les épisodes : {0}"

msgctxt "#30050"
msgid "Could not load episodes - try again"
msgstr "Impossible de charger les épisodes, réessayez"

msgctxt "#30051"
msgid "Season {0}"
msgstr "Saison {0}"

msgctxt "#30052"
msgid "Search Netflix"
msgstr "Rechercher sur Netflix"

# ---- Settings: categories ----
msgctxt "#30100"
msgid "General"
msgstr "Général"

msgctxt "#30101"
msgid "Choose how titles play and which Netflix profile to use."
msgstr "Choisissez comment les titres sont lus et quel profil Netflix utiliser."

msgctxt "#30102"
msgid "Embedded player"
msgstr "Lecteur intégré"

msgctxt "#30103"
msgid "Settings for the built-in WebView2 player window. Used when 'Playback location' is 'Embedded'."
msgstr "Réglages de la fenêtre de lecture WebView2 intégrée. Utilisés lorsque « Emplacement de lecture » vaut « Intégré »."

msgctxt "#30104"
msgid "Delegate mode"
msgstr "Lecture externe"

msgctxt "#30105"
msgid "Settings for handing playback to an external browser or app. Used when 'Playback location' is 'Delegate'."
msgstr "Réglages pour confier la lecture à un navigateur ou une application externe. Utilisés lorsque « Emplacement de lecture » vaut « Externe »."

# ---- Settings: groups ----
msgctxt "#30110"
msgid "Playback"
msgstr "Lecture"

msgctxt "#30111"
msgid "Netflix profile"
msgstr "Profil Netflix"

msgctxt "#30112"
msgid "WebView2 host"
msgstr "Hôte WebView2"

msgctxt "#30113"
msgid "Netflix app / browser"
msgstr "Application Netflix / navigateur"

msgctxt "#30115"
msgid "Startup"
msgstr "Démarrage"

# ---- Settings: playback ----
msgctxt "#30120"
msgid "Playback location"
msgstr "Emplacement de lecture"

msgctxt "#30121"
msgid "Where titles play. Embedded: in the add-on's own window (up to 4K, with the Kodi subtitle font). Delegate: hand off to the Netflix app or the Edge/Chrome browser."
msgstr "Où les titres sont lus. Intégré : dans la fenêtre de l'extension (jusqu'à 4K, avec la police de sous-titres de Kodi). Externe : la lecture est confiée à l'application Netflix ou au navigateur Edge/Chrome."

msgctxt "#30122"
msgid "Embedded - built-in window (up to 4K)"
msgstr "Intégré - fenêtre intégrée (jusqu'à 4K)"

msgctxt "#30123"
msgid "Delegate - play in browser/app"
msgstr "Externe - lecture dans le navigateur/l'application"

# ---- Settings: profile ----
msgctxt "#30124"
msgid "Switch profile..."
msgstr "Changer de profil..."

msgctxt "#30125"
msgid "Choose the Netflix profile to browse and play with."
msgstr "Choisissez le profil Netflix utilisé pour parcourir et lire."

msgctxt "#30126"
msgid "Profile to auto-select on start"
msgstr "Profil sélectionné au démarrage"

msgctxt "#30127"
msgid "Which profile the browser daemon enters on start (0 = first). Normally just use 'Switch profile...' above."
msgstr "Profil ouvert par le service du navigateur au démarrage (0 = le premier). En temps normal, utilisez simplement « Changer de profil... » ci-dessus."

msgctxt "#30128"
msgid "Profile number (0 = first)"
msgstr "Numéro de profil (0 = le premier)"

# ---- Settings: embedded player ----
msgctxt "#30130"
msgid "Python for the WebView2 host (optional)"
msgstr "Python pour l'hôte WebView2 (facultatif)"

msgctxt "#30131"
msgid "Path to a python.exe that has pywebview and fonttools installed; used to run the built-in Netflix window. Leave empty to use the bundled player."
msgstr "Chemin d'un python.exe où pywebview et fonttools sont installés ; sert à exécuter la fenêtre Netflix intégrée. Laissez vide pour utiliser le lecteur fourni."

msgctxt "#30132"
msgid "Select python.exe"
msgstr "Choisir python.exe"

# ---- Settings: delegate mode ----
msgctxt "#30140"
msgid "Prefer the Netflix Store app (4K)"
msgstr "Préférer l'application Netflix du Store (4K)"

msgctxt "#30141"
msgid "If installed, play with the Microsoft Store Netflix app (supports 4K). When off, use the Edge browser."
msgstr "Si elle est installée, la lecture se fait avec l'application Netflix du Microsoft Store (4K prise en charge). Si désactivé, le navigateur Edge est utilisé."

msgctxt "#30142"
msgid "Edge executable (override)"
msgstr "Exécutable Edge (manuel)"

msgctxt "#30143"
msgid "Set the path to msedge.exe manually, only if auto-detection fails."
msgstr "Indiquez le chemin de msedge.exe uniquement si la détection automatique échoue."

msgctxt "#30144"
msgid "Select msedge.exe"
msgstr "Choisir msedge.exe"

msgctxt "#30145"
msgid "Chrome executable (override)"
msgstr "Exécutable Chrome (manuel)"

msgctxt "#30146"
msgid "Set the path to chrome.exe manually, only if auto-detection fails. Used when Edge is not found."
msgstr "Indiquez le chemin de chrome.exe uniquement si la détection automatique échoue. Utilisé si Edge est introuvable."

msgctxt "#30147"
msgid "Select chrome.exe"
msgstr "Choisir chrome.exe"

# ---- Settings: startup ----
msgctxt "#30150"
msgid "Start Netflix with Kodi"
msgstr "Démarrer Netflix avec Kodi"

msgctxt "#30151"
msgid "Start the Netflix browser in the background when Kodi starts and load the home screen, so the add-on opens at once. Uses about 1 GB of memory while Kodi runs."
msgstr "Démarre le navigateur Netflix en arrière-plan au lancement de Kodi et précharge l'accueil, pour que l'extension s'ouvre aussitôt. Utilise environ 1 Go de mémoire tant que Kodi fonctionne."
