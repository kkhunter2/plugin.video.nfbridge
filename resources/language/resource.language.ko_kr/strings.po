msgstr ""
"Project-Id-Version: plugin.video.nfbridge\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ko_KR\n"

msgctxt "#30001"
msgid "Search"
msgstr "검색"

msgctxt "#30002"
msgid "My List"
msgstr "내가 찜한 리스트"

msgctxt "#30003"
msgid "Series & Movies"
msgstr "시리즈와 영화"

msgctxt "#30004"
msgid "Profiles"
msgstr "프로필"

msgctxt "#30005"
msgid "Sign out"
msgstr "로그아웃"

msgctxt "#30006"
msgid "Sign in to Netflix"
msgstr "넷플릭스 로그인"

msgctxt "#30007"
msgid "Series"
msgstr "시리즈"

msgctxt "#30008"
msgid "Movies"
msgstr "영화"

msgctxt "#30009"
msgid "Starting Netflix..."
msgstr "Netflix 시작 중..."

msgctxt "#30010"
msgid "Stop the current playback to browse Netflix"
msgstr "Netflix를 탐색하려면 현재 재생을 먼저 중지하세요"

msgctxt "#30011"
msgid "Profile switched"
msgstr "프로필을 전환했습니다"

msgctxt "#30012"
msgid "Netflix is busy - try again"
msgstr "Netflix가 응답 중입니다. 잠시 후 다시 시도하세요"

# ---- Player OSD ----
msgctxt "#30020"
msgid "Play"
msgstr "재생"

msgctxt "#30021"
msgid "Pause"
msgstr "일시정지"

msgctxt "#30022"
msgid "Subtitles"
msgstr "자막"

msgctxt "#30023"
msgid "Next episode"
msgstr "다음 화"

msgctxt "#30024"
msgid "Back"
msgstr "뒤로"

# ---- Settings: categories ----
msgctxt "#30100"
msgid "General"
msgstr "일반"

msgctxt "#30101"
msgid "Choose how titles play and which Netflix profile to use."
msgstr "재생 방식과 Netflix 프로필을 설정합니다."

msgctxt "#30102"
msgid "Embedded player (Windows)"
msgstr "임베디드 플레이어 (Windows)"

msgctxt "#30103"
msgid "Settings for the built-in WebView2 player window. Used when 'Playback location' is 'Embedded'."
msgstr "내장 WebView2 재생 창에 대한 설정입니다. ‘재생 위치’가 ‘임베디드’일 때 사용됩니다."

msgctxt "#30104"
msgid "Delegate mode"
msgstr "위임 모드"

msgctxt "#30105"
msgid "Settings for handing playback to an external browser or app. Used when 'Playback location' is 'Delegate'."
msgstr "재생을 외부 브라우저·앱으로 넘길 때의 설정입니다. ‘재생 위치’가 ‘위임’일 때 사용됩니다."

# ---- Settings: groups ----
msgctxt "#30110"
msgid "Playback"
msgstr "재생"

msgctxt "#30111"
msgid "Netflix profile"
msgstr "Netflix 프로필"

msgctxt "#30112"
msgid "WebView2 host"
msgstr "WebView2 호스트"

msgctxt "#30113"
msgid "Windows"
msgstr "Windows"

msgctxt "#30114"
msgid "Other platforms"
msgstr "기타 플랫폼"

# ---- Settings: playback ----
msgctxt "#30120"
msgid "Playback location"
msgstr "재생 위치"

msgctxt "#30121"
msgid "Where titles play. Embedded: in the add-on's own window (Windows, up to 4K, Kodi subtitle font). Delegate: hand off to the OS Netflix client (Windows = Edge/app, macOS = Safari, Linux = Chrome)."
msgstr "영상을 어디서 재생할지 선택합니다. 임베디드: 애드온 내장 창에서 재생(Windows, 최대 4K, Kodi 자막 폰트 적용). 위임: OS의 Netflix 클라이언트로 넘깁니다(Windows=Edge/앱, macOS=Safari, Linux=Chrome)."

msgctxt "#30122"
msgid "Embedded - built-in window (Windows, up to 4K)"
msgstr "임베디드 — 내장 창 (Windows · 최대 4K)"

msgctxt "#30123"
msgid "Delegate - play in browser/app"
msgstr "위임 — 브라우저·앱으로 재생"

# ---- Settings: profile ----
msgctxt "#30124"
msgid "Switch profile..."
msgstr "프로필 전환…"

msgctxt "#30125"
msgid "Choose a Netflix profile. After you pick one, the player window shows the 'Who's watching?' screen to complete the switch."
msgstr "Netflix 프로필을 선택합니다. 목록에서 고르면 재생 창에 ‘누가 시청하나요?’ 화면이 떠서 전환됩니다."

msgctxt "#30126"
msgid "Profile to auto-select on start"
msgstr "시작 시 자동 선택할 프로필 번호"

msgctxt "#30127"
msgid "Which profile the browser daemon enters on start (0 = first). Normally just use 'Switch profile...' above."
msgstr "브라우징이 시작될 때 자동으로 들어갈 프로필 순번입니다(0 = 첫 번째). 평소에는 위의 ‘프로필 전환’을 사용하세요."

msgctxt "#30128"
msgid "Profile number (0 = first)"
msgstr "프로필 번호 (0 = 첫 번째)"

# ---- Settings: embedded player ----
msgctxt "#30130"
msgid "Python for the WebView2 host (optional)"
msgstr "WebView2 호스트용 Python (선택)"

msgctxt "#30131"
msgid "Path to a python.exe that has pywebview and fonttools installed; used to run the built-in Netflix window. Leave empty if you use the bundled exe."
msgstr "pywebview와 fonttools가 설치된 python.exe 경로입니다. 내장 Netflix 창을 띄우는 데 사용합니다. 번들 exe를 사용한다면 비워 두세요."

msgctxt "#30132"
msgid "Select python.exe"
msgstr "python.exe 선택"

# ---- Settings: delegate mode ----
msgctxt "#30140"
msgid "Prefer the Netflix Store app (4K)"
msgstr "Netflix 스토어 앱 우선 사용 (4K)"

msgctxt "#30141"
msgid "If installed, play with the Microsoft Store Netflix app (supports 4K). When off, use the Edge browser."
msgstr "설치돼 있으면 Microsoft Store의 Netflix 앱으로 재생합니다(4K 지원). 끄면 Edge 브라우저를 사용합니다."

msgctxt "#30142"
msgid "Edge executable (override)"
msgstr "Edge 실행 파일 직접 지정 (선택)"

msgctxt "#30143"
msgid "Set the path to msedge.exe manually, only if auto-detection fails."
msgstr "자동으로 찾지 못할 때만 msedge.exe 경로를 직접 지정합니다."

msgctxt "#30144"
msgid "Select msedge.exe"
msgstr "msedge.exe 선택"

msgctxt "#30145"
msgid "Chrome/Chromium executable (override)"
msgstr "Chrome/Chromium 실행 파일 직접 지정 (선택)"

msgctxt "#30146"
msgid "Set the path to the chrome executable manually (e.g. on Linux) if auto-detection fails."
msgstr "Linux 등에서 자동으로 찾지 못할 때 chrome 실행 파일 경로를 직접 지정합니다."

msgctxt "#30147"
msgid "Select chrome"
msgstr "chrome 선택"

msgctxt "#30148"
msgid "macOS browser app name"
msgstr "macOS 브라우저 앱 이름"

msgctxt "#30149"
msgid "Name of the browser app used to open Netflix on macOS (e.g. Safari, Google Chrome)."
msgstr "macOS에서 Netflix를 열 브라우저 앱 이름입니다(예: Safari, Google Chrome)."
