# Kodi Media Center language file
# Addon Name: Nflix
# Addon id: plugin.video.nfbridge
msgid ""
msgstr ""
"Project-Id-Version: plugin.video.nfbridge\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ko_KR\n"

# ---- Browse ----
msgctxt "#30001"
msgid "Search"
msgstr "검색"

msgctxt "#30002"
msgid "My List"
msgstr "내가 찜한 리스트"

msgctxt "#30003"
msgid "Series & Movies"
msgstr "시리즈와 영화"

msgctxt "#30004"
msgid "Profiles"
msgstr "프로필"

msgctxt "#30005"
msgid "Sign out"
msgstr "로그아웃"

msgctxt "#30006"
msgid "Sign in to Netflix"
msgstr "Netflix 로그인"

msgctxt "#30007"
msgid "Series"
msgstr "시리즈"

msgctxt "#30008"
msgid "Movies"
msgstr "영화"

msgctxt "#30009"
msgid "Starting Netflix..."
msgstr "Netflix 시작 중..."

msgctxt "#30010"
msgid "Stop the current playback to browse Netflix"
msgstr "Netflix를 탐색하려면 현재 재생을 먼저 중지하세요"

msgctxt "#30011"
msgid "Profile switched"
msgstr "프로필을 전환했습니다"

msgctxt "#30012"
msgid "Netflix is busy - try again"
msgstr "Netflix가 응답 중입니다. 잠시 후 다시 시도하세요"

# ---- Player OSD ----
msgctxt "#30020"
msgid "Play"
msgstr "재생"

msgctxt "#30021"
msgid "Pause"
msgstr "일시정지"

msgctxt "#30022"
msgid "Subtitles"
msgstr "자막"

msgctxt "#30023"
msgid "Next episode"
msgstr "다음 화"

msgctxt "#30024"
msgid "Back"
msgstr "뒤로"

# ---- Messages ----
msgctxt "#30030"
msgid "No Netflix app, Edge or Chrome found for playback"
msgstr "재생할 Netflix 앱, Edge, Chrome을 찾지 못했습니다"

msgctxt "#30031"
msgid "Netflix is not ready"
msgstr "Netflix가 아직 준비되지 않았습니다"

msgctxt "#30032"
msgid "Profile switch failed"
msgstr "프로필을 전환하지 못했습니다"

msgctxt "#30033"
msgid "Pick a profile in the Netflix window, then open the add-on again"
msgstr "Netflix 창에서 프로필을 고른 뒤 애드온을 다시 여세요"

msgctxt "#30034"
msgid "Netflix runtime not found - reinstall the add-on"
msgstr "Netflix 실행 파일이 없습니다. 애드온을 다시 설치하세요"

msgctxt "#30035"
msgid "Sign in to Netflix in the window, then return to Kodi"
msgstr "창에서 Netflix에 로그인한 뒤 Kodi로 돌아오세요"

msgctxt "#30036"
msgid "Could not open the sign-in window"
msgstr "로그인 창을 열지 못했습니다"

msgctxt "#30037"
msgid "Subtitle font \"{0}\" is unusable - using the Netflix font"
msgstr "자막 폰트 \"{0}\"을(를) 쓸 수 없어 Netflix 폰트를 사용합니다"

msgctxt "#30038"
msgid "Could not process the subtitle font - using the Netflix font"
msgstr "자막 폰트를 처리하지 못해 Netflix 폰트를 사용합니다"

msgctxt "#30039"
msgid "No video selected"
msgstr "선택한 영상이 없습니다"

msgctxt "#30040"
msgid "Not signed in to Netflix - use \"Sign in to Netflix\" first"
msgstr "Netflix에 로그인하지 않았습니다. 먼저 \"Netflix 로그인\"을 실행하세요"

msgctxt "#30041"
msgid "Could not load home: {0}"
msgstr "홈을 불러오지 못했습니다: {0}"

msgctxt "#30042"
msgid "This row is no longer on Netflix"
msgstr "이 행은 이제 Netflix에 없습니다"

msgctxt "#30043"
msgid "Could not load row: {0}"
msgstr "행을 불러오지 못했습니다: {0}"

msgctxt "#30044"
msgid "No profiles found"
msgstr "프로필을 찾지 못했습니다"

msgctxt "#30045"
msgid "Could not load category: {0}"
msgstr "카테고리를 불러오지 못했습니다: {0}"

msgctxt "#30046"
msgid "Sign out of Netflix on this PC?"
msgstr "이 PC의 Netflix에서 로그아웃할까요?"

msgctxt "#30047"
msgid "Could not load My List: {0}"
msgstr "내가 찜한 리스트를 불러오지 못했습니다: {0}"

msgctxt "#30048"
msgid "Search failed: {0}"
msgstr "검색하지 못했습니다: {0}"

msgctxt "#30049"
msgid "Could not load episodes: {0}"
msgstr "에피소드를 불러오지 못했습니다: {0}"

msgctxt "#30050"
msgid "Could not load episodes - try again"
msgstr "에피소드를 불러오지 못했습니다. 다시 시도하세요"

msgctxt "#30051"
msgid "Season {0}"
msgstr "시즌 {0}"

msgctxt "#30052"
msgid "Search Netflix"
msgstr "Netflix 검색"

msgctxt "#30053"
msgid "Signed out of Netflix"
msgstr "Netflix에서 로그아웃했습니다"

msgctxt "#30054"
msgid "Could not sign out - try again"
msgstr "로그아웃하지 못했습니다. 다시 시도하세요"

msgctxt "#30056"
msgid "Windows blocked the Netflix player (Smart App Control) - see the README"
msgstr "Windows가 Netflix 플레이어를 차단했습니다(스마트 앱 컨트롤). README를 확인하세요"

msgctxt "#30057"
msgid "Could not start the Netflix player: {0}"
msgstr "Netflix 플레이어를 시작하지 못했습니다: {0}"

# ---- Settings: categories ----
msgctxt "#30100"
msgid "General"
msgstr "일반"

msgctxt "#30101"
msgid "Choose how titles play and which Netflix profile to use."
msgstr "재생 방식과 Netflix 프로필을 설정합니다."

msgctxt "#30102"
msgid "Embedded player"
msgstr "임베디드 플레이어"

msgctxt "#30103"
msgid "Settings for the built-in WebView2 player window. Used when 'Playback location' is 'Embedded'."
msgstr "내장 WebView2 재생 창에 대한 설정입니다. ‘재생 위치’가 ‘임베디드’일 때 사용됩니다."

msgctxt "#30104"
msgid "Delegate mode"
msgstr "위임 모드"

msgctxt "#30105"
msgid "Settings for handing playback to an external browser or app. Used when 'Playback location' is 'Delegate'."
msgstr "재생을 외부 브라우저·앱으로 넘길 때의 설정입니다. ‘재생 위치’가 ‘위임’일 때 사용됩니다."

# ---- Settings: groups ----
msgctxt "#30110"
msgid "Playback"
msgstr "재생"

msgctxt "#30111"
msgid "Netflix profile"
msgstr "Netflix 프로필"

msgctxt "#30112"
msgid "WebView2 host"
msgstr "WebView2 호스트"

msgctxt "#30113"
msgid "Netflix app / browser"
msgstr "Netflix 앱·브라우저"

msgctxt "#30115"
msgid "Startup"
msgstr "시작"

# ---- Settings: playback ----
msgctxt "#30120"
msgid "Playback location"
msgstr "재생 위치"

msgctxt "#30121"
msgid "Where titles play. Embedded: in the add-on's own window (up to 4K, with the Kodi subtitle font). Delegate: hand off to the Netflix app or the Edge/Chrome browser."
msgstr "영상을 어디서 재생할지 고릅니다. 임베디드: 애드온의 내장 창에서 재생합니다(최대 4K, Kodi 자막 폰트 적용). 위임: Netflix 앱이나 Edge·Chrome 브라우저로 넘깁니다."

msgctxt "#30122"
msgid "Embedded - built-in window (up to 4K)"
msgstr "임베디드 — 내장 창 (최대 4K)"

msgctxt "#30123"
msgid "Delegate - play in browser/app"
msgstr "위임 — 브라우저·앱으로 재생"

# ---- Settings: profile ----
msgctxt "#30124"
msgid "Switch profile..."
msgstr "프로필 전환…"

msgctxt "#30125"
msgid "Choose the Netflix profile to browse and play with."
msgstr "탐색하고 재생할 Netflix 프로필을 고릅니다."

msgctxt "#30126"
msgid "Profile to auto-select on start"
msgstr "시작 시 자동 선택할 프로필 번호"

msgctxt "#30127"
msgid "Which profile the browser daemon enters on start (0 = first). Normally just use 'Switch profile...' above."
msgstr "브라우징이 시작될 때 자동으로 들어갈 프로필 순번입니다(0 = 첫 번째). 평소에는 위의 ‘프로필 전환’을 사용하세요."

msgctxt "#30128"
msgid "Profile number (0 = first)"
msgstr "프로필 번호 (0 = 첫 번째)"

# ---- Settings: embedded player ----
msgctxt "#30130"
msgid "Python for the WebView2 host (optional)"
msgstr "WebView2 호스트용 Python (선택)"

msgctxt "#30131"
msgid "Path to a python.exe that has pywebview and fonttools installed; used to run the built-in Netflix window. Leave empty to use the bundled player."
msgstr "pywebview와 fonttools가 설치된 python.exe 경로입니다. 내장 Netflix 창을 띄우는 데 사용합니다. 비워 두면 함께 들어 있는 플레이어를 사용합니다."

msgctxt "#30132"
msgid "Select python.exe"
msgstr "python.exe 선택"

# ---- Settings: delegate mode ----
msgctxt "#30140"
msgid "Prefer the Netflix Store app (4K)"
msgstr "Netflix 스토어 앱 우선 사용 (4K)"

msgctxt "#30141"
msgid "If installed, play with the Microsoft Store Netflix app (supports 4K). When off, use the Edge browser."
msgstr "설치돼 있으면 Microsoft Store의 Netflix 앱으로 재생합니다(4K 지원). 끄면 Edge 브라우저를 사용합니다."

msgctxt "#30142"
msgid "Edge executable (override)"
msgstr "Edge 실행 파일 직접 지정 (선택)"

msgctxt "#30143"
msgid "Set the path to msedge.exe manually, only if auto-detection fails."
msgstr "자동으로 찾지 못할 때만 msedge.exe 경로를 직접 지정합니다."

msgctxt "#30144"
msgid "Select msedge.exe"
msgstr "msedge.exe 선택"

msgctxt "#30145"
msgid "Chrome executable (override)"
msgstr "Chrome 실행 파일 직접 지정 (선택)"

msgctxt "#30146"
msgid "Set the path to chrome.exe manually, only if auto-detection fails. Used when Edge is not found."
msgstr "자동으로 찾지 못할 때만 chrome.exe 경로를 직접 지정합니다. Edge가 없을 때 사용합니다."

msgctxt "#30147"
msgid "Select chrome.exe"
msgstr "chrome.exe 선택"

# ---- Settings: startup ----
msgctxt "#30150"
msgid "Start Netflix with Kodi"
msgstr "Kodi와 함께 Netflix 시작"

msgctxt "#30151"
msgid "Start the Netflix browser in the background when Kodi starts and load the home screen, so the add-on opens at once. Uses about 1 GB of memory while Kodi runs."
msgstr "Kodi가 시작될 때 Netflix 브라우저를 뒤에서 띄우고 홈 화면을 미리 받아 두어, 애드온이 바로 열리게 합니다. Kodi가 켜져 있는 동안 메모리를 약 1GB 사용합니다."
