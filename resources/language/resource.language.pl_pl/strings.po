# ---- Browse ----
msgctxt "#30001"
msgid "Search"
msgstr "Szukaj"

msgctxt "#30002"
msgid "My List"
msgstr "Moja lista"

msgctxt "#30003"
msgid "Series & Movies"
msgstr "Seriale i filmy"

msgctxt "#30004"
msgid "Profiles"
msgstr "Profile"

msgctxt "#30005"
msgid "Sign out"
msgstr "Wyloguj się"

msgctxt "#30006"
msgid "Sign in to Netflix"
msgstr "Zaloguj się do Netflix"

msgctxt "#30007"
msgid "Series"
msgstr "Seriale"

msgctxt "#30008"
msgid "Movies"
msgstr "Filmy"

msgctxt "#30009"
msgid "Starting Netflix..."
msgstr "Uruchamianie Netflix..."

msgctxt "#30010"
msgid "Stop the current playback to browse Netflix"
msgstr "Zatrzymaj bieżące odtwarzanie, aby przeglądać Netflix"

msgctxt "#30011"
msgid "Profile switched"
msgstr "Przełączono profil"

msgctxt "#30012"
msgid "Netflix is busy - try again"
msgstr "Netflix jest zajęty – spróbuj ponownie"

# ---- Player OSD ----
msgctxt "#30020"
msgid "Play"
msgstr "Odtwórz"

msgctxt "#30021"
msgid "Pause"
msgstr "Pauza"

msgctxt "#30022"
msgid "Subtitles"
msgstr "Napisy"

msgctxt "#30023"
msgid "Next episode"
msgstr "Następny odcinek"

msgctxt "#30024"
msgid "Back"
msgstr "Wstecz"

# ---- Messages ----
msgctxt "#30030"
msgid "No Netflix app, Edge or Chrome found for playback"
msgstr "Nie znaleziono aplikacji Netflix, Edge ani Chrome do odtwarzania"

msgctxt "#30031"
msgid "Netflix is not ready"
msgstr "Netflix nie jest gotowy"

msgctxt "#30032"
msgid "Profile switch failed"
msgstr "Nie udało się przełączyć profilu"

msgctxt "#30033"
msgid "Pick a profile in the Netflix window, then open the add-on again"
msgstr "Wybierz profil w oknie Netflix, a potem ponownie otwórz dodatek"

msgctxt "#30034"
msgid "Netflix runtime not found - reinstall the add-on"
msgstr "Nie znaleziono środowiska Netflix – zainstaluj dodatek ponownie"

msgctxt "#30035"
msgid "Sign in to Netflix in the window, then return to Kodi"
msgstr "Zaloguj się do Netflix w oknie, a potem wróć do Kodi"

msgctxt "#30036"
msgid "Could not open the sign-in window"
msgstr "Nie udało się otworzyć okna logowania"

msgctxt "#30037"
msgid "Subtitle font \"{0}\" is unusable - using the Netflix font"
msgstr "Czcionka napisów „{0}” nie nadaje się do użytku – używana jest czcionka Netflix"

msgctxt "#30038"
msgid "Could not process the subtitle font - using the Netflix font"
msgstr "Nie udało się przetworzyć czcionki napisów – używana jest czcionka Netflix"

msgctxt "#30039"
msgid "No video selected"
msgstr "Nie wybrano filmu"

msgctxt "#30040"
msgid "Not signed in to Netflix - use \"Sign in to Netflix\" first"
msgstr "Nie zalogowano do Netflix – najpierw użyj „Zaloguj się do Netflix”"

msgctxt "#30041"
msgid "Could not load home: {0}"
msgstr "Nie udało się wczytać strony głównej: {0}"

msgctxt "#30042"
msgid "This row is no longer on Netflix"
msgstr "Tego rzędu nie ma już w Netflix"

msgctxt "#30043"
msgid "Could not load row: {0}"
msgstr "Nie udało się wczytać rzędu: {0}"

msgctxt "#30044"
msgid "No profiles found"
msgstr "Nie znaleziono profili"

msgctxt "#30045"
msgid "Could not load category: {0}"
msgstr "Nie udało się wczytać kategorii: {0}"

msgctxt "#30046"
msgid "Sign out of Netflix on this PC?"
msgstr "Wylogować się z Netflix na tym komputerze?"

msgctxt "#30047"
msgid "Could not load My List: {0}"
msgstr "Nie udało się wczytać Mojej listy: {0}"

msgctxt "#30048"
msgid "Search failed: {0}"
msgstr "Wyszukiwanie nie powiodło się: {0}"

msgctxt "#30049"
msgid "Could not load episodes: {0}"
msgstr "Nie udało się wczytać odcinków: {0}"

msgctxt "#30050"
msgid "Could not load episodes - try again"
msgstr "Nie udało się wczytać odcinków – spróbuj ponownie"

msgctxt "#30051"
msgid "Season {0}"
msgstr "Sezon {0}"

msgctxt "#30052"
msgid "Search Netflix"
msgstr "Szukaj w Netflix"

msgctxt "#30053"
msgid "Signed out of Netflix"
msgstr "Wylogowano z Netflix"

msgctxt "#30054"
msgid "Could not sign out - try again"
msgstr "Nie udało się wylogować – spróbuj ponownie"

# ---- Settings: categories ----
msgctxt "#30100"
msgid "General"
msgstr "Ogólne"

msgctxt "#30101"
msgid "Choose how titles play and which Netflix profile to use."
msgstr "Wybierz sposób odtwarzania i profil Netflix."

msgctxt "#30102"
msgid "Embedded player"
msgstr "Wbudowany odtwarzacz"

msgctxt "#30103"
msgid "Settings for the built-in WebView2 player window. Used when 'Playback location' is 'Embedded'."
msgstr "Ustawienia wbudowanego okna odtwarzania WebView2. Używane, gdy „Miejsce odtwarzania” to „Wbudowane”."

msgctxt "#30104"
msgid "Delegate mode"
msgstr "Odtwarzanie zewnętrzne"

msgctxt "#30105"
msgid "Settings for handing playback to an external browser or app. Used when 'Playback location' is 'Delegate'."
msgstr "Ustawienia przekazywania odtwarzania do zewnętrznej przeglądarki lub aplikacji. Używane, gdy „Miejsce odtwarzania” to „Zewnętrzne”."

# ---- Settings: groups ----
msgctxt "#30110"
msgid "Playback"
msgstr "Odtwarzanie"

msgctxt "#30111"
msgid "Netflix profile"
msgstr "Profil Netflix"

msgctxt "#30112"
msgid "WebView2 host"
msgstr "Host WebView2"

msgctxt "#30113"
msgid "Netflix app / browser"
msgstr "Aplikacja Netflix / przeglądarka"

msgctxt "#30115"
msgid "Startup"
msgstr "Uruchamianie"

# ---- Settings: playback ----
msgctxt "#30120"
msgid "Playback location"
msgstr "Miejsce odtwarzania"

msgctxt "#30121"
msgid "Where titles play. Embedded: in the add-on's own window (up to 4K, with the Kodi subtitle font). Delegate: hand off to the Netflix app or the Edge/Chrome browser."
msgstr "Gdzie odtwarzane są tytuły. Wbudowane: we własnym oknie dodatku (do 4K, z czcionką napisów Kodi). Zewnętrzne: przekazanie do aplikacji Netflix lub przeglądarki Edge/Chrome."

msgctxt "#30122"
msgid "Embedded - built-in window (up to 4K)"
msgstr "Wbudowane – wbudowane okno (do 4K)"

msgctxt "#30123"
msgid "Delegate - play in browser/app"
msgstr "Zewnętrzne – odtwarzanie w przeglądarce/aplikacji"

# ---- Settings: profile ----
msgctxt "#30124"
msgid "Switch profile..."
msgstr "Przełącz profil..."

msgctxt "#30125"
msgid "Choose the Netflix profile to browse and play with."
msgstr "Wybierz profil Netflix do przeglądania i odtwarzania."

msgctxt "#30126"
msgid "Profile to auto-select on start"
msgstr "Profil wybierany przy uruchomieniu"

msgctxt "#30127"
msgid "Which profile the browser daemon enters on start (0 = first). Normally just use 'Switch profile...' above."
msgstr "Profil, który usługa przeglądarki otwiera przy uruchomieniu (0 = pierwszy). Zwykle wystarczy użyć „Przełącz profil...” powyżej."

msgctxt "#30128"
msgid "Profile number (0 = first)"
msgstr "Numer profilu (0 = pierwszy)"

# ---- Settings: embedded player ----
msgctxt "#30130"
msgid "Python for the WebView2 host (optional)"
msgstr "Python dla hosta WebView2 (opcjonalnie)"

msgctxt "#30131"
msgid "Path to a python.exe that has pywebview and fonttools installed; used to run the built-in Netflix window. Leave empty to use the bundled player."
msgstr "Ścieżka do python.exe z zainstalowanymi pywebview i fonttools; służy do uruchamiania wbudowanego okna Netflix. Pozostaw puste, aby użyć dołączonego odtwarzacza."

msgctxt "#30132"
msgid "Select python.exe"
msgstr "Wybierz python.exe"

# ---- Settings: delegate mode ----
msgctxt "#30140"
msgid "Prefer the Netflix Store app (4K)"
msgstr "Preferuj aplikację Netflix ze Sklepu (4K)"

msgctxt "#30141"
msgid "If installed, play with the Microsoft Store Netflix app (supports 4K). When off, use the Edge browser."
msgstr "Jeśli jest zainstalowana, odtwarza w aplikacji Netflix z Microsoft Store (obsługa 4K). Po wyłączeniu używana jest przeglądarka Edge."

msgctxt "#30142"
msgid "Edge executable (override)"
msgstr "Plik wykonywalny Edge (ręcznie)"

msgctxt "#30143"
msgid "Set the path to msedge.exe manually, only if auto-detection fails."
msgstr "Podaj ścieżkę do msedge.exe tylko wtedy, gdy automatyczne wykrywanie zawiedzie."

msgctxt "#30144"
msgid "Select msedge.exe"
msgstr "Wybierz msedge.exe"

msgctxt "#30145"
msgid "Chrome executable (override)"
msgstr "Plik wykonywalny Chrome (ręcznie)"

msgctxt "#30146"
msgid "Set the path to chrome.exe manually, only if auto-detection fails. Used when Edge is not found."
msgstr "Podaj ścieżkę do chrome.exe tylko wtedy, gdy automatyczne wykrywanie zawiedzie. Używany, gdy nie znaleziono Edge."

msgctxt "#30147"
msgid "Select chrome.exe"
msgstr "Wybierz chrome.exe"

# ---- Settings: startup ----
msgctxt "#30150"
msgid "Start Netflix with Kodi"
msgstr "Uruchamiaj Netflix razem z Kodi"

msgctxt "#30151"
msgid "Start the Netflix browser in the background when Kodi starts and load the home screen, so the add-on opens at once. Uses about 1 GB of memory while Kodi runs."
msgstr "Przy starcie Kodi uruchamia przeglądarkę Netflix w tle i wstępnie wczytuje stronę główną, aby dodatek otwierał się od razu. Zajmuje około 1 GB pamięci, gdy Kodi działa."
