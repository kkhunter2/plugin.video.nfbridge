# ---- Browse ----
msgctxt "#30001"
msgid "Search"
msgstr "Buscar"

msgctxt "#30002"
msgid "My List"
msgstr "Minha lista"

msgctxt "#30003"
msgid "Series & Movies"
msgstr "Séries e filmes"

msgctxt "#30004"
msgid "Profiles"
msgstr "Perfis"

msgctxt "#30005"
msgid "Sign out"
msgstr "Sair"

msgctxt "#30006"
msgid "Sign in to Netflix"
msgstr "Entrar na Netflix"

msgctxt "#30007"
msgid "Series"
msgstr "Séries"

msgctxt "#30008"
msgid "Movies"
msgstr "Filmes"

msgctxt "#30009"
msgid "Starting Netflix..."
msgstr "Iniciando a Netflix..."

msgctxt "#30010"
msgid "Stop the current playback to browse Netflix"
msgstr "Pare a reprodução atual para navegar na Netflix"

msgctxt "#30011"
msgid "Profile switched"
msgstr "Perfil alterado"

msgctxt "#30012"
msgid "Netflix is busy - try again"
msgstr "A Netflix está ocupada, tente novamente"

# ---- Player OSD ----
msgctxt "#30020"
msgid "Play"
msgstr "Reproduzir"

msgctxt "#30021"
msgid "Pause"
msgstr "Pausar"

msgctxt "#30022"
msgid "Subtitles"
msgstr "Legendas"

msgctxt "#30023"
msgid "Next episode"
msgstr "Próximo episódio"

msgctxt "#30024"
msgid "Back"
msgstr "Voltar"

# ---- Messages ----
msgctxt "#30030"
msgid "No Netflix app, Edge or Chrome found for playback"
msgstr "Nenhum app da Netflix, Edge ou Chrome encontrado para reprodução"

msgctxt "#30031"
msgid "Netflix is not ready"
msgstr "A Netflix não está pronta"

msgctxt "#30032"
msgid "Profile switch failed"
msgstr "Falha ao trocar de perfil"

msgctxt "#30033"
msgid "Pick a profile in the Netflix window, then open the add-on again"
msgstr "Escolha um perfil na janela da Netflix e abra o complemento novamente"

msgctxt "#30034"
msgid "Netflix runtime not found - reinstall the add-on"
msgstr "Ambiente da Netflix não encontrado, reinstale o complemento"

msgctxt "#30035"
msgid "Sign in to Netflix in the window, then return to Kodi"
msgstr "Entre na Netflix pela janela e depois volte ao Kodi"

msgctxt "#30036"
msgid "Could not open the sign-in window"
msgstr "Não foi possível abrir a janela de login"

msgctxt "#30037"
msgid "Subtitle font \"{0}\" is unusable - using the Netflix font"
msgstr "A fonte de legenda “{0}” não pode ser usada; será usada a fonte da Netflix"

msgctxt "#30038"
msgid "Could not process the subtitle font - using the Netflix font"
msgstr "Não foi possível processar a fonte de legenda; será usada a fonte da Netflix"

msgctxt "#30039"
msgid "No video selected"
msgstr "Nenhum vídeo selecionado"

msgctxt "#30040"
msgid "Not signed in to Netflix - use \"Sign in to Netflix\" first"
msgstr "Você não entrou na Netflix; use antes “Entrar na Netflix”"

msgctxt "#30041"
msgid "Could not load home: {0}"
msgstr "Não foi possível carregar o início: {0}"

msgctxt "#30042"
msgid "This row is no longer on Netflix"
msgstr "Esta fileira não está mais na Netflix"

msgctxt "#30043"
msgid "Could not load row: {0}"
msgstr "Não foi possível carregar a fileira: {0}"

msgctxt "#30044"
msgid "No profiles found"
msgstr "Nenhum perfil encontrado"

msgctxt "#30045"
msgid "Could not load category: {0}"
msgstr "Não foi possível carregar a categoria: {0}"

msgctxt "#30046"
msgid "Sign out of Netflix on this PC?"
msgstr "Sair da Netflix neste PC?"

msgctxt "#30047"
msgid "Could not load My List: {0}"
msgstr "Não foi possível carregar Minha lista: {0}"

msgctxt "#30048"
msgid "Search failed: {0}"
msgstr "Falha na busca: {0}"

msgctxt "#30049"
msgid "Could not load episodes: {0}"
msgstr "Não foi possível carregar os episódios: {0}"

msgctxt "#30050"
msgid "Could not load episodes - try again"
msgstr "Não foi possível carregar os episódios, tente novamente"

msgctxt "#30051"
msgid "Season {0}"
msgstr "Temporada {0}"

msgctxt "#30052"
msgid "Search Netflix"
msgstr "Buscar na Netflix"

msgctxt "#30053"
msgid "Signed out of Netflix"
msgstr "Você saiu da Netflix"

msgctxt "#30054"
msgid "Could not sign out - try again"
msgstr "Não foi possível sair, tente novamente"

msgctxt "#30056"
msgid "Windows blocked the Netflix player (Smart App Control) - see the README"
msgstr "O Windows bloqueou o player da Netflix (Controle Inteligente de Aplicativos) - veja o README"

msgctxt "#30057"
msgid "Could not start the Netflix player: {0}"
msgstr "Não foi possível iniciar o player da Netflix: {0}"

# ---- Settings: categories ----
msgctxt "#30100"
msgid "General"
msgstr "Geral"

msgctxt "#30101"
msgid "Choose how titles play and which Netflix profile to use."
msgstr "Escolha como os títulos são reproduzidos e qual perfil da Netflix usar."

msgctxt "#30102"
msgid "Embedded player"
msgstr "Player integrado"

msgctxt "#30103"
msgid "Settings for the built-in WebView2 player window. Used when 'Playback location' is 'Embedded'."
msgstr "Configurações da janela de reprodução WebView2 integrada. Usadas quando “Local de reprodução” é “Integrado”."

msgctxt "#30104"
msgid "Delegate mode"
msgstr "Reprodução externa"

msgctxt "#30105"
msgid "Settings for handing playback to an external browser or app. Used when 'Playback location' is 'Delegate'."
msgstr "Configurações para passar a reprodução a um navegador ou app externo. Usadas quando “Local de reprodução” é “Externo”."

# ---- Settings: groups ----
msgctxt "#30110"
msgid "Playback"
msgstr "Reprodução"

msgctxt "#30111"
msgid "Netflix profile"
msgstr "Perfil da Netflix"

msgctxt "#30112"
msgid "WebView2 host"
msgstr "Host WebView2"

msgctxt "#30113"
msgid "Netflix app / browser"
msgstr "App da Netflix / navegador"

msgctxt "#30115"
msgid "Startup"
msgstr "Inicialização"

# ---- Settings: playback ----
msgctxt "#30120"
msgid "Playback location"
msgstr "Local de reprodução"

msgctxt "#30121"
msgid "Where titles play. Embedded: in the add-on's own window (up to 4K, with the Kodi subtitle font). Delegate: hand off to the Netflix app or the Edge/Chrome browser."
msgstr "Onde os títulos são reproduzidos. Integrado: na própria janela do complemento (até 4K, com a fonte de legenda do Kodi). Externo: passa para o app da Netflix ou para o navegador Edge/Chrome."

msgctxt "#30122"
msgid "Embedded - built-in window (up to 4K)"
msgstr "Integrado - janela integrada (até 4K)"

msgctxt "#30123"
msgid "Delegate - play in browser/app"
msgstr "Externo - reproduzir no navegador/app"

# ---- Settings: profile ----
msgctxt "#30124"
msgid "Switch profile..."
msgstr "Trocar de perfil..."

msgctxt "#30125"
msgid "Choose the Netflix profile to browse and play with."
msgstr "Escolha o perfil da Netflix usado para navegar e assistir."

msgctxt "#30126"
msgid "Profile to auto-select on start"
msgstr "Perfil selecionado ao iniciar"

msgctxt "#30127"
msgid "Which profile the browser daemon enters on start (0 = first). Normally just use 'Switch profile...' above."
msgstr "Perfil que o serviço do navegador abre ao iniciar (0 = o primeiro). Normalmente basta usar “Trocar de perfil...” acima."

msgctxt "#30128"
msgid "Profile number (0 = first)"
msgstr "Número do perfil (0 = o primeiro)"

# ---- Settings: embedded player ----
msgctxt "#30130"
msgid "Python for the WebView2 host (optional)"
msgstr "Python para o host WebView2 (opcional)"

msgctxt "#30131"
msgid "Path to a python.exe that has pywebview and fonttools installed; used to run the built-in Netflix window. Leave empty to use the bundled player."
msgstr "Caminho de um python.exe com pywebview e fonttools instalados; usado para executar a janela integrada da Netflix. Deixe vazio para usar o player incluído."

msgctxt "#30132"
msgid "Select python.exe"
msgstr "Selecionar python.exe"

# ---- Settings: delegate mode ----
msgctxt "#30140"
msgid "Prefer the Netflix Store app (4K)"
msgstr "Preferir o app da Netflix da Store (4K)"

msgctxt "#30141"
msgid "If installed, play with the Microsoft Store Netflix app (supports 4K). When off, use the Edge browser."
msgstr "Se estiver instalado, reproduz com o app da Netflix da Microsoft Store (suporta 4K). Se desativado, usa o navegador Edge."

msgctxt "#30142"
msgid "Edge executable (override)"
msgstr "Executável do Edge (manual)"

msgctxt "#30143"
msgid "Set the path to msedge.exe manually, only if auto-detection fails."
msgstr "Informe o caminho do msedge.exe somente se a detecção automática falhar."

msgctxt "#30144"
msgid "Select msedge.exe"
msgstr "Selecionar msedge.exe"

msgctxt "#30145"
msgid "Chrome executable (override)"
msgstr "Executável do Chrome (manual)"

msgctxt "#30146"
msgid "Set the path to chrome.exe manually, only if auto-detection fails. Used when Edge is not found."
msgstr "Informe o caminho do chrome.exe somente se a detecção automática falhar. Usado quando o Edge não é encontrado."

msgctxt "#30147"
msgid "Select chrome.exe"
msgstr "Selecionar chrome.exe"

# ---- Settings: startup ----
msgctxt "#30150"
msgid "Start Netflix with Kodi"
msgstr "Iniciar a Netflix com o Kodi"

msgctxt "#30151"
msgid "Start the Netflix browser in the background when Kodi starts and load the home screen, so the add-on opens at once. Uses about 1 GB of memory while Kodi runs."
msgstr "Inicia o navegador da Netflix em segundo plano quando o Kodi abre e pré-carrega o início, para que o complemento abra na hora. Usa cerca de 1 GB de memória enquanto o Kodi estiver aberto."
