# ---- Browse ----
msgctxt "#30001"
msgid "Search"
msgstr "搜索"

msgctxt "#30002"
msgid "My List"
msgstr "我的片单"

msgctxt "#30003"
msgid "Series & Movies"
msgstr "剧集和电影"

msgctxt "#30004"
msgid "Profiles"
msgstr "个人资料"

msgctxt "#30005"
msgid "Sign out"
msgstr "退出登录"

msgctxt "#30006"
msgid "Sign in to Netflix"
msgstr "登录 Netflix"

msgctxt "#30007"
msgid "Series"
msgstr "剧集"

msgctxt "#30008"
msgid "Movies"
msgstr "电影"

msgctxt "#30009"
msgid "Starting Netflix..."
msgstr "正在启动 Netflix..."

msgctxt "#30010"
msgid "Stop the current playback to browse Netflix"
msgstr "请先停止当前播放，再浏览 Netflix"

msgctxt "#30011"
msgid "Profile switched"
msgstr "已切换个人资料"

msgctxt "#30012"
msgid "Netflix is busy - try again"
msgstr "Netflix 正忙，请重试"

# ---- Player OSD ----
msgctxt "#30020"
msgid "Play"
msgstr "播放"

msgctxt "#30021"
msgid "Pause"
msgstr "暂停"

msgctxt "#30022"
msgid "Subtitles"
msgstr "字幕"

msgctxt "#30023"
msgid "Next episode"
msgstr "下一集"

msgctxt "#30024"
msgid "Back"
msgstr "返回"

# ---- Messages ----
msgctxt "#30030"
msgid "No Netflix app, Edge or Chrome found for playback"
msgstr "未找到可用于播放的 Netflix 应用、Edge 或 Chrome"

msgctxt "#30031"
msgid "Netflix is not ready"
msgstr "Netflix 尚未就绪"

msgctxt "#30032"
msgid "Profile switch failed"
msgstr "切换个人资料失败"

msgctxt "#30033"
msgid "Pick a profile in the Netflix window, then open the add-on again"
msgstr "请在 Netflix 窗口中选择个人资料，然后重新打开插件"

msgctxt "#30034"
msgid "Netflix runtime not found - reinstall the add-on"
msgstr "未找到 Netflix 运行组件，请重新安装插件"

msgctxt "#30035"
msgid "Sign in to Netflix in the window, then return to Kodi"
msgstr "请在窗口中登录 Netflix，然后返回 Kodi"

msgctxt "#30036"
msgid "Could not open the sign-in window"
msgstr "无法打开登录窗口"

msgctxt "#30037"
msgid "Subtitle font \"{0}\" is unusable - using the Netflix font"
msgstr "字幕字体“{0}”无法使用，将使用 Netflix 字体"

msgctxt "#30038"
msgid "Could not process the subtitle font - using the Netflix font"
msgstr "无法处理字幕字体，将使用 Netflix 字体"

msgctxt "#30039"
msgid "No video selected"
msgstr "未选择视频"

msgctxt "#30040"
msgid "Not signed in to Netflix - use \"Sign in to Netflix\" first"
msgstr "尚未登录 Netflix，请先使用“登录 Netflix”"

msgctxt "#30041"
msgid "Could not load home: {0}"
msgstr "无法加载首页：{0}"

msgctxt "#30042"
msgid "This row is no longer on Netflix"
msgstr "Netflix 上已没有这一栏"

msgctxt "#30043"
msgid "Could not load row: {0}"
msgstr "无法加载此栏：{0}"

msgctxt "#30044"
msgid "No profiles found"
msgstr "未找到个人资料"

msgctxt "#30045"
msgid "Could not load category: {0}"
msgstr "无法加载分类：{0}"

msgctxt "#30046"
msgid "Sign out of Netflix on this PC?"
msgstr "要在这台电脑上退出 Netflix 登录吗？"

msgctxt "#30047"
msgid "Could not load My List: {0}"
msgstr "无法加载我的片单：{0}"

msgctxt "#30048"
msgid "Search failed: {0}"
msgstr "搜索失败：{0}"

msgctxt "#30049"
msgid "Could not load episodes: {0}"
msgstr "无法加载分集：{0}"

msgctxt "#30050"
msgid "Could not load episodes - try again"
msgstr "无法加载分集，请重试"

msgctxt "#30051"
msgid "Season {0}"
msgstr "第 {0} 季"

msgctxt "#30052"
msgid "Search Netflix"
msgstr "搜索 Netflix"

msgctxt "#30053"
msgid "Signed out of Netflix"
msgstr "已退出 Netflix 登录"

msgctxt "#30054"
msgid "Could not sign out - try again"
msgstr "无法退出登录，请重试"

msgctxt "#30056"
msgid "Windows blocked the Netflix player (Smart App Control) - see the README"
msgstr "Windows 阻止了 Netflix 播放器（智能应用控制）- 请参阅 README"

msgctxt "#30057"
msgid "Could not start the Netflix player: {0}"
msgstr "无法启动 Netflix 播放器：{0}"

# ---- Settings: categories ----
msgctxt "#30100"
msgid "General"
msgstr "常规"

msgctxt "#30101"
msgid "Choose how titles play and which Netflix profile to use."
msgstr "选择影片的播放方式和要使用的 Netflix 个人资料。"

msgctxt "#30102"
msgid "Embedded player"
msgstr "内置播放器"

msgctxt "#30103"
msgid "Settings for the built-in WebView2 player window. Used when 'Playback location' is 'Embedded'."
msgstr "内置 WebView2 播放窗口的设置。仅在“播放位置”为“内置”时使用。"

msgctxt "#30104"
msgid "Delegate mode"
msgstr "外部播放"

msgctxt "#30105"
msgid "Settings for handing playback to an external browser or app. Used when 'Playback location' is 'Delegate'."
msgstr "将播放交给外部浏览器或应用时的设置。仅在“播放位置”为“外部播放”时使用。"

# ---- Settings: groups ----
msgctxt "#30110"
msgid "Playback"
msgstr "播放"

msgctxt "#30111"
msgid "Netflix profile"
msgstr "Netflix 个人资料"

msgctxt "#30112"
msgid "WebView2 host"
msgstr "WebView2 主机"

msgctxt "#30113"
msgid "Netflix app / browser"
msgstr "Netflix 应用/浏览器"

msgctxt "#30115"
msgid "Startup"
msgstr "启动"

# ---- Settings: playback ----
msgctxt "#30120"
msgid "Playback location"
msgstr "播放位置"

msgctxt "#30121"
msgid "Where titles play. Embedded: in the add-on's own window (up to 4K, with the Kodi subtitle font). Delegate: hand off to the Netflix app or the Edge/Chrome browser."
msgstr "选择影片在哪里播放。内置：在插件自己的窗口中播放（最高 4K，使用 Kodi 字幕字体）。外部播放：交给 Netflix 应用或 Edge/Chrome 浏览器。"

msgctxt "#30122"
msgid "Embedded - built-in window (up to 4K)"
msgstr "内置 - 内置窗口（最高 4K）"

msgctxt "#30123"
msgid "Delegate - play in browser/app"
msgstr "外部播放 - 在浏览器/应用中播放"

# ---- Settings: profile ----
msgctxt "#30124"
msgid "Switch profile..."
msgstr "切换个人资料..."

msgctxt "#30125"
msgid "Choose the Netflix profile to browse and play with."
msgstr "选择用于浏览和播放的 Netflix 个人资料。"

msgctxt "#30126"
msgid "Profile to auto-select on start"
msgstr "启动时自动选择的个人资料"

msgctxt "#30127"
msgid "Which profile the browser daemon enters on start (0 = first). Normally just use 'Switch profile...' above."
msgstr "浏览器后台程序启动时进入的个人资料序号（0 = 第一个）。通常直接使用上面的“切换个人资料...”即可。"

msgctxt "#30128"
msgid "Profile number (0 = first)"
msgstr "个人资料序号（0 = 第一个）"

# ---- Settings: embedded player ----
msgctxt "#30130"
msgid "Python for the WebView2 host (optional)"
msgstr "WebView2 主机使用的 Python（可选）"

msgctxt "#30131"
msgid "Path to a python.exe that has pywebview and fonttools installed; used to run the built-in Netflix window. Leave empty to use the bundled player."
msgstr "已安装 pywebview 和 fonttools 的 python.exe 路径，用于运行内置 Netflix 窗口。留空则使用自带的播放器。"

msgctxt "#30132"
msgid "Select python.exe"
msgstr "选择 python.exe"

# ---- Settings: delegate mode ----
msgctxt "#30140"
msgid "Prefer the Netflix Store app (4K)"
msgstr "优先使用应用商店中的 Netflix 应用（4K）"

msgctxt "#30141"
msgid "If installed, play with the Microsoft Store Netflix app (supports 4K). When off, use the Edge browser."
msgstr "如已安装，则使用 Microsoft Store 中的 Netflix 应用播放（支持 4K）。关闭时使用 Edge 浏览器。"

msgctxt "#30142"
msgid "Edge executable (override)"
msgstr "Edge 可执行文件（手动指定）"

msgctxt "#30143"
msgid "Set the path to msedge.exe manually, only if auto-detection fails."
msgstr "仅在无法自动检测时手动指定 msedge.exe 的路径。"

msgctxt "#30144"
msgid "Select msedge.exe"
msgstr "选择 msedge.exe"

msgctxt "#30145"
msgid "Chrome executable (override)"
msgstr "Chrome 可执行文件（手动指定）"

msgctxt "#30146"
msgid "Set the path to chrome.exe manually, only if auto-detection fails. Used when Edge is not found."
msgstr "仅在无法自动检测时手动指定 chrome.exe 的路径。找不到 Edge 时使用。"

msgctxt "#30147"
msgid "Select chrome.exe"
msgstr "选择 chrome.exe"

# ---- Settings: startup ----
msgctxt "#30150"
msgid "Start Netflix with Kodi"
msgstr "随 Kodi 启动 Netflix"

msgctxt "#30151"
msgid "Start the Netflix browser in the background when Kodi starts and load the home screen, so the add-on opens at once. Uses about 1 GB of memory while Kodi runs."
msgstr "Kodi 启动时在后台启动 Netflix 浏览器并预先加载首页，让插件立即打开。Kodi 运行期间约占用 1 GB 内存。"
