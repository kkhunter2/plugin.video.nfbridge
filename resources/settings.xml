<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="nfbridge">
    <category id="playback" label="Playback">
      <group id="1" label="Mode">
        <setting id="playback_mode" type="string" label="Playback mode" help="How titles are played. 'Embedded' plays in the bundled WebView2 window (up to 4K, Kodi subtitle font) on Windows. 'Delegate' hands off to the OS's Netflix client (Edge/app on Windows, Safari on macOS, Chrome on Linux).">
          <level>0</level>
          <default>embedded</default>
          <constraints>
            <options>
              <option label="Embedded WebView2 (Windows; 4K + Kodi subtitle font)">embedded</option>
              <option label="Delegate to browser/app">delegate</option>
            </options>
          </constraints>
          <control type="list" format="string"/>
        </setting>
      </group>
      <group id="2" label="Delegate paths (optional overrides)">
        <setting id="use_uwp_app" type="boolean" label="Prefer the Netflix Store app (Windows, 4K)">
          <level>1</level><default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="edge_path" type="path" label="Edge executable (override)">
          <level>2</level><default></default>
          <control type="button" format="file"><heading>Select msedge.exe</heading></control>
        </setting>
        <setting id="chrome_path" type="path" label="Chrome/Chromium executable (override)">
          <level>2</level><default></default>
          <control type="button" format="file"><heading>Select chrome</heading></control>
        </setting>
        <setting id="macos_browser" type="string" label="macOS browser app name">
          <level>2</level><default>Safari</default>
          <control type="edit" format="string"/>
        </setting>
      </group>
      <group id="3" label="Embedded player (WebView2, Windows)">
        <setting id="webview_python" type="path" label="Python for the WebView2 host (needs pywebview + fonttools)" help="Path to a python.exe that has pywebview and fonttools installed; runs the embedded Edge WebView2 Netflix window. Leave empty to use Delegate mode.">
          <level>1</level><default></default>
          <control type="button" format="file"><heading>Select python.exe</heading></control>
        </setting>
        <setting id="profile_index" type="integer" label="Active Netflix profile (index)" help="Which profile the browse daemon selects (0 = first). Set it from the Profiles screen.">
          <level>3</level><default>0</default>
          <control type="edit" format="integer"><heading>Profile index</heading></control>
        </setting>
      </group>
    </category>
  </section>
</settings>
