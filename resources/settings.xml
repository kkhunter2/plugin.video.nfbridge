<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
  <section id="nfbridge">

    <!-- ================= General ================= -->
    <category id="general" label="30100" help="30101">
      <group id="1" label="30110">
        <setting id="playback_mode" type="string" label="30120" help="30121">
          <level>0</level>
          <default>embedded</default>
          <constraints>
            <options>
              <option label="30122">embedded</option>
              <option label="30123">delegate</option>
            </options>
          </constraints>
          <control type="list" format="string"/>
        </setting>
      </group>

      <group id="2" label="30111">
        <setting id="switch_profile" type="action" label="30124" help="30125">
          <level>0</level>
          <data>RunPlugin(plugin://plugin.video.nfbridge/?action=pickprofile)</data>
          <control type="button" format="action">
            <close>true</close>
          </control>
        </setting>
        <setting id="profile_index" type="integer" label="30126" help="30127">
          <level>2</level>
          <default>0</default>
          <control type="edit" format="integer"><heading>30128</heading></control>
        </setting>
        <!-- the chosen profile's Netflix guid (set by 'Switch profile'); exact match at the gate -->
        <setting id="profile_guid" type="string" label="30126">
          <level>4</level>
          <default>-</default>
          <visible>false</visible>
          <control type="edit" format="string"/>
        </setting>
      </group>

      <group id="3" label="30115">
        <setting id="prestart" type="boolean" label="30150" help="30151">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>

    <!-- ============ Embedded player ============ -->
    <category id="embedded" label="30102" help="30103">
      <group id="1" label="30112">
        <setting id="webview_python" type="path" label="30130" help="30131">
          <level>0</level>
          <default></default><constraints><allowempty>true</allowempty></constraints>
          <control type="button" format="file"><heading>30132</heading></control>
        </setting>
      </group>
    </category>

    <!-- ============== Delegate mode ============== -->
    <category id="delegate" label="30104" help="30105">
      <group id="1" label="30113">
        <setting id="use_uwp_app" type="boolean" label="30140" help="30141">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="edge_path" type="path" label="30142" help="30143">
          <level>1</level>
          <default></default><constraints><allowempty>true</allowempty></constraints>
          <control type="button" format="file"><heading>30144</heading></control>
        </setting>
        <setting id="chrome_path" type="path" label="30145" help="30146">
          <level>1</level>
          <default></default><constraints><allowempty>true</allowempty></constraints>
          <control type="button" format="file"><heading>30147</heading></control>
        </setting>
      </group>
    </category>

  </section>
</settings>
